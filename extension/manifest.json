{
  "manifest_version": 3,
  "name": "Udemy 課程繁體中文字幕",
  "version": "1.0.16",
  "description": "由 Codex 預先翻譯的課程雙語字幕，依影片時間同步。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "課程繁中字幕"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.udemy.com/course/ai-in-c-sharp-using-the-microsoft-agent-framework/*",
        "https://www.udemy.com/course/mastering-microsoft-agent-framework-in-c/*",
        "https://www.udemy.com/course/fraud-detection-using-python/*",
        "https://www.udemy.com/course/detect-fake-news-with-machine-learning-feature-engineering/*",
        "https://www.udemy.com/course/building-a-rag-application-in-python/*",
        "https://www.udemy.com/course/machinelearning/*",
        "https://www.udemy.com/course/python-for-data-science-and-machine-learning-bootcamp/*",
        "https://www.udemy.com/course/building-recommender-systems-with-machine-learning-and-ai/*",
        "https://www.udemy.com/course/fastapi-banking-with-ai-ml-fraud-detection/*",
        "https://www.udemy.com/course/math-with-python/*",
        "https://www.udemy.com/course/pycalc1_x/*",
        "https://www.udemy.com/course/statsml_x/*",
        "https://www.udemy.com/course/complete-machine-learning-and-data-science-zero-to-mastery/*",
        "https://www.udemy.com/course/dullms_x/*",
        "https://www.udemy.com/course/pytorch-for-deep-learning/*"
      ],
      "js": [
        "courses.js",
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/index.json",
        "data/*/*.json"
      ],
      "matches": [
        "https://www.udemy.com/*"
      ]
    }
  ]
}
