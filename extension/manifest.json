{
  "manifest_version": 3,
  "name": "Agent Framework 雙課程｜繁體中文字幕",
  "version": "1.0.0",
  "description": "為兩門 Microsoft Agent Framework Udemy 課程顯示預先翻譯、依時間同步的繁中與英文字幕。",
  "permissions": ["storage"],
  "action": {"default_popup": "popup.html", "default_title": "課程繁中字幕"},
  "content_scripts": [{
    "matches": ["https://www.udemy.com/course/ai-in-c-sharp-using-the-microsoft-agent-framework/*", "https://www.udemy.com/course/mastering-microsoft-agent-framework-in-c/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["data/*.json"],
    "matches": ["https://www.udemy.com/*"]
  }]
}
